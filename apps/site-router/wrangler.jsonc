{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starbot-site-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "*.starbot.site/*",
      "zone_name": "starbot.site"
    }
  ],
  "vars": {
    "ACCOUNT_ORIGIN": "https://starbot.app"
  },
  "r2_buckets": [
    {
      "binding": "SITES",
      "bucket_name": "starbot-sites",
      "preview_bucket_name": "starbot-sites-test"
    }
  ]
}
