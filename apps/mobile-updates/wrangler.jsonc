{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starbot-mobile-updates",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "updates.starbot.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false
  },
  "r2_buckets": [
    {
      "binding": "UPDATES",
      "bucket_name": "starbot-mobile-updates",
      "preview_bucket_name": "starbot-mobile-updates-test"
    }
  ]
}
