{
  "expo": {
    "name": "星友",
    "slug": "starbot-mobile",
    "platforms": ["ios", "android"],
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "scheme": ["starbot"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.think2do.starbot",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "星友",
        "NSLocalNetworkUsageDescription": "允许「星友」在同一局域网下直连你电脑上的星友工作台。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["fetch"],
        "BGTaskSchedulerPermittedIdentifiers": ["com.think2do.starbot.refresh"]
      },
      "icon": "./assets/icons/app-icon.png"
    },
    "android": {
      "package": "com.think2do.starbot",
      "icon": "./assets/icons/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/app-icon.png",
        "backgroundImage": "./assets/icons/android-adaptive-background.png",
        "monochromeImage": "./assets/icons/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "./plugins/with-rocketsim",
      "./plugins/with-workspace-bundle-inputs",
      "./plugins/with-update-channel",
      "./plugins/with-android-view-preallocation-off",
      "./plugins/with-android-optional-features",
      "expo-router",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5FF",
          "image": "./assets/splash/starbot-splash.png",
          "imageWidth": 188,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#151224",
            "image": "./assets/splash/starbot-splash.png"
          },
          "android": {
            "imageWidth": 168
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许「星友」使用相机扫描电脑端配对二维码。",
          "microphonePermission": "允许「星友」使用麦克风进行语音输入。",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许「星友」访问你选择的照片并发送给助手。",
          "cameraPermission": "允许「星友」使用相机拍照发送给助手。",
          "microphonePermission": "允许「星友」使用麦克风进行语音输入。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "允许「星友」访问你选择的照片。",
          "savePhotosPermission": "允许「星友」将助手生成的图片或视频保存到系统相册。",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification-icon.png",
          "color": "#6E56F5"
        }
      ],
      [
        "./plugins/with-notification-sounds",
        {
          "sounds": [
            "./assets/sounds/openbot-task.wav",
            "./assets/sounds/openbot-warm.wav",
            "./assets/sounds/openbot-mech.wav",
            "./assets/sounds/openbot-bubble.wav",
            "./assets/sounds/openbot-press.wav"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "允许「星友」使用面容 ID 解锁保护你的私人助手空间。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许「星友」在你主动分享位置时获取当前位置，协助查询周边信息。",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-dontwarn org.webrtc.Dav1dDecoder$Natives"
          }
        }
      ],
      [
        "./plugins/with-share-target",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.think2do.starbot",
            "extensionBundleIdentifier": "com.think2do.starbot.ShareExtension",
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 10,
              "supportsMovieWithMaxCount": 10,
              "supportsFileWithMaxCount": 10
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["*/*"],
            "multipleShareMimeTypes": ["*/*"]
          }
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/inter/Inter-Regular.ttf",
              "./assets/fonts/inter/Inter-Italic.ttf",
              "./assets/fonts/inter/Inter-Medium.ttf",
              "./assets/fonts/inter/Inter-SemiBold.ttf",
              "./assets/fonts/inter/Inter-Bold.ttf",
              "./assets/fonts/inter/Inter-BoldItalic.ttf",
              "./assets/fonts/inter/Inter-ExtraBold.ttf",
              "katex/dist/fonts/KaTeX_AMS-Regular.ttf",
              "katex/dist/fonts/KaTeX_Caligraphic-Regular.ttf",
              "katex/dist/fonts/KaTeX_Fraktur-Regular.ttf",
              "katex/dist/fonts/KaTeX_Main-Bold.ttf",
              "katex/dist/fonts/KaTeX_Main-Italic.ttf",
              "katex/dist/fonts/KaTeX_Main-Regular.ttf",
              "katex/dist/fonts/KaTeX_Math-BoldItalic.ttf",
              "katex/dist/fonts/KaTeX_Math-Italic.ttf",
              "katex/dist/fonts/KaTeX_SansSerif-Regular.ttf",
              "katex/dist/fonts/KaTeX_Size1-Regular.ttf",
              "katex/dist/fonts/KaTeX_Size2-Regular.ttf",
              "katex/dist/fonts/KaTeX_Typewriter-Regular.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  { "path": "./assets/fonts/inter/Inter-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/inter/Inter-Italic.ttf", "weight": 400, "style": "italic" },
                  { "path": "./assets/fonts/inter/Inter-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/inter/Inter-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/inter/Inter-Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/inter/Inter-BoldItalic.ttf", "weight": 700, "style": "italic" },
                  { "path": "./assets/fonts/inter/Inter-ExtraBold.ttf", "weight": 800 }
                ]
              },
              "katex/dist/fonts/KaTeX_AMS-Regular.ttf",
              "katex/dist/fonts/KaTeX_Caligraphic-Regular.ttf",
              "katex/dist/fonts/KaTeX_Fraktur-Regular.ttf",
              "katex/dist/fonts/KaTeX_Main-Bold.ttf",
              "katex/dist/fonts/KaTeX_Main-Italic.ttf",
              "katex/dist/fonts/KaTeX_Main-Regular.ttf",
              "katex/dist/fonts/KaTeX_Math-BoldItalic.ttf",
              "katex/dist/fonts/KaTeX_Math-Italic.ttf",
              "katex/dist/fonts/KaTeX_SansSerif-Regular.ttf",
              "katex/dist/fonts/KaTeX_Size1-Regular.ttf",
              "katex/dist/fonts/KaTeX_Size2-Regular.ttf",
              "katex/dist/fonts/KaTeX_Typewriter-Regular.ttf"
            ]
          }
        }
      ],
      "expo-image",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "允许「星友」使用麦克风进行语音输入。",
          "speechRecognitionPermission": "允许「星友」将你的语音实时转为文字指令。"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "允许「星友」使用相机扫描电脑端配对二维码。",
          "microphonePermission": "允许「星友」使用麦克风与助手实时语音通话。"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.think2do.starbot.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.think2do.starbot",
          "enablePushNotifications": true,
          "frequentUpdates": true
        }
      ],
      [
        "./plugins/with-notification-service",
        {
          "targetName": "StarBotNotificationService",
          "bundleIdentifier": "com.think2do.starbot.NotificationService",
          "groupIdentifier": "group.com.think2do.starbot"
        }
      ],
      "./plugins/with-shortcuts",
      "./plugins/with-xcode-warning-fixes"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    },
    "runtimeVersion": "0.2.0",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    }
  }
}
