#!/bin/sh
set -eu
export PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C
ROOT='/Library/Application Support/StarBot/HostManager'
"$ROOT/starbot-host" --verify-installation
if [ -f "$ROOT/config.json" ] && [ ! -L "$ROOT/config.json" ]; then
  launchctl bootstrap system /Library/LaunchDaemons/app.starbot.host-manager.plist
fi
echo 'StarBot Host installed. Run sudo starbot-host setup, then sudo starbot-host verify.'
