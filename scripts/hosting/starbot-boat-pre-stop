#!/bin/bash
# starbot-boat-pre-stop: installed by starbot-hosted-update. Changes to this file are replaced.
set -u

sudo -n touch /run/starbot-pre-stop || exit 1
sudo -n systemctl stop starbot-pre-stop-restart.timer 2>/dev/null
sudo -n systemd-run --quiet --collect --unit=starbot-pre-stop-restart --on-active=15min /bin/sh -c \
  'if find /run/starbot-pre-stop -mmin +5 2>/dev/null | grep -q .; then rm -f /run/starbot-pre-stop && systemctl start --no-block starbot.service; fi' ||
  echo "The start after a cancelled stop is not set." >&2
if sudo -n timeout 40 systemctl stop starbot.service; then exit 0; fi
sudo -n systemctl kill --signal=SIGKILL starbot.service
for _ in $(seq 1 10); do
  case $(systemctl show --property=ActiveState --value starbot.service) in
    inactive | failed) exit 0 ;;
  esac
  sleep 0.5
done
exit 1
