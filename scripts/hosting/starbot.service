[Unit]
Description=StarBot hosted server
Wants=network-online.target starbot-update-apply.service
After=network-online.target display-manager.service
ConditionPathExists=!/run/starbot-pre-stop

[Service]
Type=simple
User=@SERVICE_USER@
RuntimeDirectory=starbot
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/starbot
ExecStartPre=-+/opt/StarBot/hosted/starbot-hosted-update trigger
ExecStart=/opt/StarBot/hosted/starbot-hosted-server
ExecStop=/opt/StarBot/hosted/starbot-hosted-server --stop
Restart=always
RestartSec=10
RestartPreventExitStatus=78
TimeoutStopSec=60
MemoryMax=90%
OOMScoreAdjust=-500
OOMPolicy=continue

[Install]
WantedBy=multi-user.target lightdm.service
