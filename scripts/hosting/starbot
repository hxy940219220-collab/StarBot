#!/bin/bash
set -euo pipefail
# shellcheck source=starbot-hosted-update
source "$(dirname "$(readlink -f "$0")")/starbot-hosted-update"
umask 077

SOCKET=/run/starbot/control.sock
UNIT=starbot.service

usage() {
  cat <<'EOF'
Usage: starbot <command>

  status                         Show the account and the server.
  login [<email>] [--name <name>]
                                 Sign in with a code that StarBot sends to your email.
                                 The server then shows in the server list of that account.
                                 Its name is "StarBot" when you give no name.
  login --claim [--name <name>]  Sign in with a one-time claim that the operator made for
                                 the owner's email. No code is needed. The claim comes from
                                 standard input, or a hidden prompt in a terminal.
  mobile-connect                 Show a QR code that connects the StarBot phone app to this
                                 account. It works for one sign-in and expires after two minutes.
  logout                         Sign out. The server stops until the next sign-in.
  name <name>                    Change the server name.
  logs [-f]                      Show the StarBot log.
  start | stop | restart         Control the StarBot service (sudo).
  update                         Install the newest release now (sudo).
  uninstall                      Sign out and remove StarBot. The data stays (sudo).
  version                        Show the installed version.
EOF
}

service_user() {
  cat "$INSTALL/hosted/service-user" 2>/dev/null || echo starbot
}

in_container() {
  [ -r "$INSTALL/hosted/mode" ] && [ "$(<"$INSTALL/hosted/mode")" = container ]
}

require_host() {
  in_container || return 0
  fail "In a container, $1. See https://github.com/nightly-labs/starbot/blob/main/docs/docker.md"
}

require_root() {
  [ "$(id -u)" -eq 0 ] || fail "Run this with sudo: sudo starbot $*"
}

not_answering() {
  if in_container; then
    fail "StarBot does not answer. Read the log on the host with: docker logs <container>"
  fi
  fail "StarBot does not answer. Read the log with: starbot logs"
}

not_running() {
  if start_loop_stopped; then
    fail "StarBot stopped because its start failed again and again. Read the log with: starbot logs
Install a new release with: sudo starbot update. Or try again with: sudo starbot restart"
  fi
  fail "StarBot is not running. Start it with: sudo starbot start"
}

wait_for_socket() {
  local second
  for ((second = 0; second < 30; second++)); do
    [ -S "$SOCKET" ] && return 0
    in_container || systemctl is-active --quiet "$UNIT" || not_running
    if ! in_container && safe_mode_running; then
      fail "StarBot does not start, so it runs its safe mode: members see why. Read the log with: starbot logs
Install a new release with: sudo starbot update. Or try again with: sudo starbot restart"
    fi
    if [ -d /run/starbot ] && [ ! -x /run/starbot ]; then
      fail "Run this with sudo, or as the user $(service_user)."
    fi
    sleep 1
  done
  not_answering
}

form_value() {
  printf '%s' "$1" | od -An -tx1 -v | tr -d ' \n' | sed 's/../%&/g'
}

control() {
  local method=$1 path=$2 field body="" arguments=()
  shift 2
  for field in "$@"; do body+="${body:+&}${field%%=*}=$(form_value "${field#*=}")"; done
  if [ "$#" -gt 0 ]; then
    arguments=(--header 'content-type: application/x-www-form-urlencoded' --data-binary @-)
  fi
  wait_for_socket
  response=$(printf '%s' "$body" | curl --silent --show-error --max-time 120 --unix-socket "$SOCKET" \
    -X "$method" "${arguments[@]}" --write-out 'status=%{http_code}\n' "http://starbot$path") ||
    not_answering
}

value() {
  sed -n "s/^$1=//p" <<<"$response" | head -n 1
}

check_answer() {
  [ "$(value status)" = 200 ] && return 0
  local message
  message=$(value message)
  if [ -z "$message" ]; then
    case $(value error) in
      invalid_email) message="Enter a valid email address." ;;
      invalid_request) message="Enter the sign-in code or the claim." ;;
      invalid_name) message="Enter a server name." ;;
      signed_in) message="This server is signed in. To use another account, run: starbot logout" ;;
      account_signed_out | account_code_sent) message="Sign in first with: starbot login" ;;
      account_error | account_loading) message="StarBot could not check the account yet. Run: starbot status" ;;
      session_not_storable) message="This server cannot store the session securely. The claim was not used." ;;
      *) message="StarBot refused the request ($(value error))." ;;
    esac
  fi
  echo "$message" >&2
  return 1
}

show_status() {
  local account server name message staged limit
  account=$(value account)
  server=$(value server)
  name=$(value server_name)
  message=$(value server_message)
  echo "StarBot $(value version)"
  case $account in
    signed_in) echo "Account: $(value email)" ;;
    signed_out) echo "Account: signed out. Sign in with: starbot login" ;;
    code_sent) echo "Account: waiting for a sign-in code. Run: starbot login" ;;
    error) echo "Account: the account server does not answer. $(value account_message)" ;;
    *) echo "Account: $account" ;;
  esac
  if [ -n "$name" ]; then echo "Server: $name ($server)"; else echo "Server: $server"; fi
  case $server in error | unconfigured) if [ -n "$message" ]; then echo "  $message"; fi ;; esac
  limit=$(value memory_limit)
  if [ -n "$limit" ]; then
    echo "Memory: $(($(value memory_available) / 1048576)) MiB free of $((limit / 1048576)) MiB ($(value memory_level))"
    turns=$(value turn_limit)
    if [ "$turns" = unlimited ]; then echo "Turns at the same time: no limit"; else echo "Turns at the same time: at most $turns"; fi
  fi
  staged=$(staged_version)
  if [ -n "$staged" ]; then echo "StarBot $staged is ready to install. Run: sudo starbot update"; fi
}

status_command() {
  control GET /v1/status
  check_answer || exit 1
  show_status
}

login_command() {
  local email="" name="" claim="" with_claim="" challenge code attempt second
  while [ "$#" -gt 0 ]; do
    case $1 in
      --name)
        [ "$#" -ge 2 ] || fail "Add a name after --name."
        name=$2
        shift 2
        ;;
      --claim)
        with_claim=1
        shift
        ;;
      -*) fail "Unknown option: $1" ;;
      *)
        email=$1
        shift
        ;;
    esac
  done
  control GET /v1/status
  check_answer || exit 1
  if [ "$(value account)" = signed_in ]; then
    show_status
    return 0
  fi
  if [ -n "$with_claim" ]; then
    [ -z "$email" ] || fail "The claim names the account. Give no email with --claim."
    if [ -t 0 ]; then read -rsp "Claim: " claim && echo; else read -r claim || true; fi
    [ -n "$claim" ] || fail "Give the claim on standard input."
    control POST /v1/login/claim "claim=$claim" ${name:+"name=$name"}
    check_answer || exit 1
    email=$(value email)
  else
    [ -t 0 ] || fail "Run starbot login in a terminal."
    if [ -z "$email" ]; then read -rp "Email: " email; fi
    control POST /v1/login/start "email=$email" ${name:+"name=$name"}
    check_answer || exit 1
    challenge=$(value challenge)
    echo "StarBot sent a sign-in code to $email."
    for attempt in 1 2 3; do
      read -rp "Code: " code
      control POST /v1/login/verify "challenge=$challenge" "code=$code" ${name:+"name=$name"}
      if check_answer; then break; fi
      [ "$attempt" -lt 3 ] || exit 1
    done
  fi
  echo "Signed in as $(value email). Publishing the server..."
  for ((second = 0; second < 90; second += 2)); do
    control GET /v1/status
    case $(value server) in online | error) break ;; esac
    if [ "$(value server)" = unconfigured ] && [ -n "$(value server_message)" ]; then break; fi
    sleep 2
  done
  show_status
  if [ "$(value server)" = online ]; then
    echo "Sign in to StarBot with $email on your computer or https://starbot.run/app to use this server."
    echo "To use it from your phone, run: starbot mobile-connect"
  fi
}

mobile_connect_command() {
  local expires_at
  control POST /v1/mobile-connect
  check_answer || exit 1
  expires_at=$(value expires_at)
  [[ $expires_at =~ ^[0-9]+$ ]] || fail "StarBot sent an invalid Mobile Connect code."
  value qr | base64 -d
  echo "In the StarBot phone app, select Scan QR code and scan this code."
  echo "It works for one sign-in and expires in $((expires_at / 1000 - $(date +%s))) seconds. Run the command again for a new code."
}

logs_command() {
  require_host "read the log on the host with: docker logs <container>"
  if [ "${1:-}" = -f ]; then exec journalctl --unit "$UNIT" --follow --lines 100; fi
  exec journalctl --unit "$UNIT" --lines 200 --no-pager
}

restart_after_failed_update() {
  local status=$?
  trap '' INT TERM HUP
  [ ! -e "$INSTALL/.applying" ] || "$INSTALL/hosted/starbot-hosted-update" apply || true
  if systemctl start "$UNIT"; then
    echo "The update failed. StarBot $(version_of "$INSTALL/app") runs. Try again with: sudo starbot update" >&2
  else
    echo "The update failed, and StarBot did not start. Read the log with: starbot logs" >&2
  fi
  exit "$status"
}

update_command() {
  require_host "pull the new image on the host, then make the container again"
  require_root update
  local before after reply
  before=$(version_of "$INSTALL/app")
  "$INSTALL/hosted/starbot-hosted-update" stage
  after=$(staged_version)
  if [ -z "$after" ]; then
    echo "StarBot $before is the newest release."
    return 0
  fi
  if [ -t 0 ]; then
    read -rp "Install StarBot $after now? StarBot stops for about a minute, and running agent turns stop. [y/N] " reply
    [[ $reply == [yY]* ]] || return 0
  fi
  trap restart_after_failed_update EXIT
  trap 'exit 1' INT TERM HUP
  systemctl stop "$UNIT"
  "$INSTALL/hosted/starbot-hosted-update" apply
  trap - EXIT INT TERM HUP
  systemctl start "$UNIT"
  echo "Installed StarBot $(version_of "$INSTALL/app")."
}

uninstall_command() {
  require_host "run starbot logout, then remove the container on the host. The data stays in its volume"
  require_root uninstall
  local user home reply unit entry
  { [ -r "$INSTALL/hosted/mode" ] && [ "$(<"$INSTALL/hosted/mode")" = self ]; } ||
    fail "This computer is not a self-hosted StarBot server."
  user=$(service_user)
  if [ -t 0 ]; then
    read -rp "Remove StarBot from this computer? The data of the user $user stays. [y/N] " reply
    [[ $reply == [yY]* ]] || return 0
  fi
  if ! (systemctl start "$UNIT" && control POST /v1/logout && check_answer); then
    echo "StarBot did not sign out. Remove the server in the app." >&2
  fi
  exec 9>"$LOCK"
  flock 9
  systemctl disable --now --quiet "${UNITS[@]}" 2>/dev/null || true
  for unit in "${UNITS[@]}"; do rm -f "/etc/systemd/system/$unit"; done
  systemctl daemon-reload
  if [ -f /etc/apparmor.d/starbot-hosted ] && command -v apparmor_parser >/dev/null &&
    [ -d /sys/kernel/security/apparmor ]; then
    apparmor_parser --remove /etc/apparmor.d/starbot-hosted 2>/dev/null || true
    if grep -qs '^# StarBot: ' /etc/apparmor.d/local/bwrap-userns-restrict; then
      sed -i -e '/^# StarBot: /d' -e '/^priority=1 allow pix \/\*\* -> &bwrap,$/d' \
        /etc/apparmor.d/local/bwrap-userns-restrict
      apparmor_parser --replace /etc/apparmor.d/bwrap-userns-restrict 2>/dev/null || true
    fi
  fi
  rm -f /etc/apparmor.d/starbot-hosted /usr/local/bin/starbot
  for entry in app hosted staged staged.ready .applying; do rm -rf "${INSTALL:?}/$entry"; done
  rmdir "$INSTALL" 2>/dev/null || true
  home=$(getent passwd "$user" | cut -d: -f6)
  echo "Removed StarBot. The data stays in ${home:-the home folder of $user} and /srv/starbot-hosted."
  echo "To install again with this data: the install command, with --user $user."
  echo "To delete the data too: sudo userdel --remove $user && sudo rm -rf /srv/starbot-hosted"
}

command=${1:-}
[ "$#" -eq 0 ] || shift
case $command in
  status) status_command ;;
  login) login_command "$@" ;;
  logout)
    control POST /v1/logout
    check_answer || exit 1
    echo "Signed out. The server is not available until the next sign-in."
    ;;
  name)
    [ "$#" -ge 1 ] || fail "Usage: starbot name <name>"
    control POST /v1/name "name=$*"
    check_answer || exit 1
    show_status
    ;;
  mobile-connect) mobile_connect_command ;;
  logs) logs_command "$@" ;;
  start | stop | restart)
    require_host "run docker $command <container> on the host"
    require_root "$command"
    systemctl "$command" "$UNIT"
    if [ "$command" = stop ]; then systemctl reset-failed "$UNIT" 2>/dev/null || true; fi
    ;;
  update) update_command ;;
  uninstall) uninstall_command ;;
  version) version_of "$INSTALL/app" ;;
  "" | help | --help | -h) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
