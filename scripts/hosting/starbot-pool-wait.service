[Unit]
Description=StarBot pool machine waits for a server
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/starbot-pool/token

[Service]
Type=simple
ExecStart=/usr/local/lib/starbot-pool/starbot-pool-wait
RuntimeDirectory=starbot-pool
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
